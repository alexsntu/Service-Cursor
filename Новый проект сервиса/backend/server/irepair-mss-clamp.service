[Unit]
Description=iRepair: TCP MSS clamp 1200 (mitigation for HTTPS stalls, set 2026-09-16)
After=network-online.target netfilter-persistent.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c "iptables -t mangle -C PREROUTING -p tcp -m tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss 1200 2>/dev/null || iptables -t mangle -A PREROUTING -p tcp -m tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss 1200"

[Install]
WantedBy=multi-user.target
